{
  "name": "@mightguy/pi-ui",
  "version": "1.2.3",
  "description": "Custom pi terminal UI with themes, layout, and message rendering",
  "type": "module",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "themes": [
      "./themes"
    ],
    "image": "https://img.dog/file/1779944542014_image.webp"
  },
  "files": [
    "src/",
    "themes/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/might-guy106/pi-ui.git"
  },
  "author": "mightguy",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint src eslint.config.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/config-loader-smoke.mjs && node --experimental-transform-types scripts/user-zone-smoke.mjs && node --experimental-transform-types scripts/tools-smoke.mjs && node --experimental-transform-types scripts/messages-smoke.mjs",
    "prepublishOnly": "npm pack --dry-run"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
